# ==============================================================================
# VeriVault Environment Configuration
# Copy this file to .env: copy .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SMART CONTRACT DEPLOYMENT (Required to deploy to Polygon Amoy)
# ------------------------------------------------------------------------------

# Private key of deployer wallet (from MetaMask / Rabby - MUST have Amoy testnet POL)
# Where to get: MetaMask -> Three Dots -> Account Details -> Show Private Key
# Where to get free Amoy POL faucet: https://faucet.polygon.technology or https://www.alchemy.com/faucets/polygon-amoy
PRIVATE_KEY=""

# Polygon Amoy Testnet RPC URL (Default public RPC provided)
POLYGON_AMOY_RPC_URL="https://rpc-amoy.polygon.technology"

# Optional: Initial admin address (Defaults to deployer wallet address if left blank)
INITIAL_ADMIN=""

# Optional: Polygonscan API Key (Only needed if you want to run `npx hardhat verify`)
# Where to get: Free at https://polygonscan.com/myapikey
POLYGONSCAN_API_KEY=""


# ------------------------------------------------------------------------------
# 2. NEXT.JS FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------

# Deployed VeriVault contract address on Polygon Amoy
# Where to get: Outputted in your terminal after running `npm run contracts:deploy:amoy`
NEXT_PUBLIC_CONTRACT_ADDRESS=""

# Frontend RPC URL (Default public RPC provided; can also use Alchemy/Infura Amoy URL)
NEXT_PUBLIC_POLYGON_AMOY_RPC_URL="https://rpc-amoy.polygon.technology"

# WalletConnect / Reown Cloud Project ID (For RainbowKit wallet connection modal)
# Where to get: Free at https://cloud.reown.com (Click "Create Project")
# (A fallback demo ID is already pre-configured in code, so this is optional for quick testing)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID="3a8170812b534d0ff9d794f19a901d64"
